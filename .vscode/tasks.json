{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "dependsOn": ["tauri"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "dev:browser",
      "dependsOn": ["server", "ui"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "tauri",
      "type": "shell",
      "command": "npx tauri dev",
      "options": { "cwd": "${workspaceFolder}/apps/nodaris-desktop" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "server",
      "type": "shell",
      "command": "cargo run -p nodaris-server",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Nodaris server running",
          "endsPattern": "(panic|error\\[)"
        }
      },
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "ui",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "build",
      "dependsOn": ["build:ui", "build:rust"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build:ui",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "problemMatcher": []
    },
    {
      "label": "build:rust",
      "type": "shell",
      "command": "cargo build --workspace",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "check",
      "dependsOn": ["check:ui", "check:rust"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "check:ui",
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "problemMatcher": []
    },
    {
      "label": "check:rust",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"]
    }
  ]
}