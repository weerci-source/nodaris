{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Запустить Nodaris Desktop через Tauri",
      "type": "shell",
      "command": "cargo tauri dev",
      "options": { "cwd": "${workspaceFolder}/apps/nodaris-desktop" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "dev:browser",
      "detail": "Запустить Axum и Vite",
      "dependsOn": ["server", "ui"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "server",
      "detail": "Запустить только HTTP-сервер Nodaris",
      "type": "shell",
      "command": "cargo run -p nodaris-server",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": ["$rustc"],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "ui",
      "hide": true,
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "build",
      "detail": "Собрать UI и Rust workspace",
      "dependsOn": ["build:ui", "build:rust"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build:ui",
      "hide": true,
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "problemMatcher": []
    },
    {
      "label": "build:rust",
      "hide": true,
      "type": "shell",
      "command": "cargo build --workspace",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "check",
      "detail": "Проверить Svelte и Rust workspace",
      "dependsOn": ["check:ui", "check:rust"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "check:ui",
      "hide": true,
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "problemMatcher": []
    },
    {
      "label": "check:rust",
      "hide": true,
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    }
  ]
}
